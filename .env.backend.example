# Copy to .env.backend and fill your gateway token.
PORT=8700
WS_PORT=8701
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TRANSPORT=auto
OPENCLAW_TIMEOUT_MS=15000
OPENCLAW_HTTP_SOFT_TIMEOUT_MS=2500
OPENCLAW_GATEWAY_TOKEN=replace_with_your_gateway_token
OPENCLAW_MAX_TASKS=500
OPENCLAW_MAX_SESSIONS=100
OPENCLAW_SESSION_IDLE_TTL_MS=1800000
OPENCLAW_TASK_RETENTION_MS=900000
OPENCLAW_SWEEP_INTERVAL_MS=30000
OPENCLAW_OUTPUT_BUFFER_MAX_BYTES=65536
OPENCLAW_OVERFLOW_POLICY=reject
OPENCLAW_CODEX_TRANSPORT=structured
OPENCLAW_CODEX_APP_SERVER_URL=ws://127.0.0.1:8788
OPENCLAW_CODEX_APP_SERVER_AUTOSTART=1
OPENCLAW_CODEX_ARGS="--ask-for-approval never --sandbox danger-full-access -c model_reasoning_effort=high --no-alt-screen"
OPENCLAW_CLAUDE_TRANSPORT=json
OPENCLAW_CLAUDE_ARGS=--dangerously-skip-permissions
OPENCLAW_CLAUDE_JSON_ARGS=
IS_SANDBOX=1
OPENCLAW_GEMINI_ARGS="--yolo --approval-mode yolo"
