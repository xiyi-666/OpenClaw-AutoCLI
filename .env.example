# OpenClaw CLI Auto 环境变量模板
# 复制此文件为 .env 后修改配置

# 应用配置
APP_NAME=openclaw-cli-auto
APP_ENV=development
APP_PORT=3000

# 数据库配置（如果需要）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=openclaw
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# 其他配置
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_key_here
